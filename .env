# ELon Merch Environment Variables
# Copy this to .env and update values for your environment

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=elonmerch_db
DB_USER=elonmerch_user
DB_PASSWORD=rootpassword

# PHP Environment
PHP_ENV=development

# API Configuration
API_URL=http://localhost:80
API_HOST=api.localhost

# Frontend Configuration
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:80

# JWT Secret (use for token-based auth if implementing)
JWT_SECRET=elonmerch_super_secret_key_2026

# CORS Configuration
CORS_ORIGIN=http://localhost,http://localhost:5173

# Admin Configuration
ADMIN_EMAIL=admin@elonmerch.com
ADMIN_PASSWORD=AdminPassword123!
